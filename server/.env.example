PORT=5000
CLIENT_URL=http://localhost:5173
# Na hostingu (server iza proxyja: Render, Railway, Nginx...) postavi na 1 — limit poruka/narudzbi ide po IP kupca
# TRUST_PROXY=1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EmailJS — narudžbe stižu na email (emailjs.com → Email Services / Email Templates / Account)
EMAILJS_SERVICE_ID=
EMAILJS_ORDER_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# EmailJS — poruke sa kontakt forme (drugi šablon, isti nalog)
# CONTACT_SERVICE_ID je opcion: bez njega se koristi EMAILJS_SERVICE_ID odozgo
EMAILJS_CONTACT_SERVICE_ID=
EMAILJS_CONTACT_TEMPLATE_ID=
